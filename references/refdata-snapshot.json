{
  "capturedAt": "2026-10-18",
  "source": "developer.apple.com/app-store/asset-best-practices + App Store Connect Help (screenshot/app-preview/creative assets) + ASC API Asset Library docs",
  "purpose": "Offline fallback for composing and validating files. The upload path MUST refresh GET /v1/appAssetLibraryRefData and resolve placement groups/specIds live.",
  "notes": [
    "Screenshot specs are exact: minWidth === maxWidth and minHeight === maxHeight.",
    "cssWidth/cssHeight are the values the desktop renderer takes; output pixels are 2x (deviceScaleFactor 2).",
    "placementGroup values marked null are not documented as fixed ids; read them from ref data.",
    "v1 targets the entries with \"v1\": true. Others are included so the validator can recognize them."
  ],
  "renderer": {
    "scale": 2,
    "rule": "export width/height are CSS points; PNG output = css * 2",
    "alpha": "must be false for every App Store asset"
  },
  "limits": {
    "screenshotsPerGroup": 10,
    "appPreviewsPerGroup": 3,
    "headerPerGroup": 1,
    "searchPerLocalization": 1,
    "eventAssetsPerPlacementType": 1,
    "maxImageBytes": 524288000
  },
